# --- required for live operation -------------------------------------------

# Honcho memory API key (https://app.honcho.dev)
HONCHO_API_KEY=
# Seeddance provider API key (sk_sd_...)
SEEDANCE_API_KEY=

# --- optional tuning ---------------------------------------------------------

# Honcho REST base + workspace (one workspace holds all demo pairs)
# HONCHO_BASE_URL=https://api.honcho.dev
# HONCHO_WORKSPACE=us-demo

# Provider endpoint + model. Do not point at a different model silently —
# the demo targets Seedance 2.5.
# SEEDANCE_API_BASE=https://www.seeddance.io
# SEEDANCE_MODEL=seedance-2.5
# SEEDANCE_POLL_INTERVAL_MS=5000

# Max wall-clock time a generation may run before it fails and the
# prerecorded fallback is offered.
# GENERATION_TIMEOUT_MS=600000
# codex exec budget for the generation-spec prompt.
# CODEX_TIMEOUT_MS=180000
# CODEX_MODEL=

# Public HTTPS origin serving /api/media/* only. Required for the provider
# to fetch confirmed photos and local references. Missing media configuration
# fails before generation; identity photos are never silently omitted.
# Keep setup, history, and job routes local when configuring a media tunnel.
# PUBLIC_MEDIA_BASE=https://your-tunnel.example.com

# Extra comma-separated CORS origins (instagram.com, chrome-extension:// and
# localhost are always allowed).
# US_ALLOWED_ORIGINS=

# Overrides for the durable store and the prerecorded fallback clip.
# FALLBACK_VIDEO=./apps/web/static/fixture.mp4

# Required backend Postgres connection. Run npm run db:migrate before starting.
# DATABASE_URL=postgresql://postgres.PROJECT:PERCENT_ENCODED_PASSWORD@POOLER_HOST:5432/postgres

# Public backend address baked into extension builds; defaults to localhost.
# Set this in the build command, e.g. VITE_US_API_BASE=https://backend.example.com npm run build -w @us/extension
