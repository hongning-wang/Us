{
  "name": "us",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @us/web",
    "dev:extension": "npm run dev -w @us/extension",
    "build": "npm run build -w @us/web && npm run build -w @us/extension",
    "check": "npm run check -w @us/web && npm run check -w @us/extension",
    "test": "NODE_ENV=test US_TEST_STORE=memory node --import tsx --test tests/*.test.ts",
    "dev:media": "node scripts/media-proxy.mjs",
    "dev:mock": "node scripts/mock-api.mjs",
    "test:e2e": "node scripts/test-native-flow.mjs && node scripts/test-history-sync.mjs",
    "db:migrate": "node --import tsx scripts/migrate-database.ts",
    "test:database": "node --import tsx scripts/test-database.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "playwright": "^1.55.0"
  }
}
