{
  "name": "@us/mobile",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5176",
    "build": "vite build && cd ../.. && node scripts/build-ios-extension.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "sync": "npm run build && cap sync ios",
    "open": "cap open ios",
    "run": "npm run sync && cap run ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/share": "^8.0.2",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
